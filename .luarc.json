{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "Lua5.2",
    "requirePattern": ["?","?.lua"]
  },
  "workspace": {
    "ignoreDir": [
      ".vscode",
      "test/factorio",
      "luals-addon/factorio/factorio-plugin",
      "luals-addon/factorio/plugin.lua",
      "out"
    ],
    "library": [
      "out/sumneko-3rd/factorio/library/runtime-api",
      "out/sumneko-3rd/factorio/library/prototype-api"
    ],
    "moduleMap": [
      {
        "pattern": "^__(.*)__(.*)$",
        "replace": "$1$2"
      },
      {
        "pattern": "^(.*)\\.lua$",
        "replace": "$1"
      }
    ]
  },
  "diagnostics": {
    "disable": ["unnecessary-if"],
    "globals": []
  }
}